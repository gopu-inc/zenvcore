import os
import sys
import json

class ProjectGenerator:
    def __init__(self, project_name="zenv-frontend"):
        self.root_dir = project_name
        self.api_url = "https://zenv-hub.onrender.com"
        
    def create_directory(self, path):
        full_path = os.path.join(self.root_dir, path)
        if not os.path.exists(full_path):
            os.makedirs(full_path)
            print(f"📁 Dossier créé : {path}")

    def write_file(self, path, content):
        full_path = os.path.join(self.root_dir, path)
        try:
            with open(full_path, 'w', encoding='utf-8') as f:
                f.write(content.strip())
            print(f"✅ Fichier généré : {path}")
        except Exception as e:
            print(f"❌ Erreur sur {path}: {str(e)}")
            sys.exit(1)

    def generate(self):
        print(f"🚀 Démarrage de la génération du projet {self.root_dir}...")
        
        # 1. Création de la structure
        if not os.path.exists(self.root_dir):
            os.makedirs(self.root_dir)
            
        directories = [
            "public",
            "src",
            "src/assets",
            "src/components",
            "src/pages",
            "src/contexts",
            "src/services",
            "src/hooks",
            "src/utils"
        ]
        
        for d in directories:
            self.create_directory(d)

        # 2. Fichiers de configuration (Root)
        self.write_package_json()
        self.write_vite_config()
        self.write_tailwind_config()
        self.write_postcss_config()
        self.write_index_html()
        self.write_gitignore()
        self.write_readme()

        # 3. Code Source (Src)
        self.write_main_jsx()
        self.write_app_jsx()
        self.write_index_css()
        
        # 4. Services & Utils
        self.write_api_service()
        self.write_utils()

        # 5. Composants
        self.write_navbar_component()
        self.write_footer_component()
        self.write_terminal_component()
        self.write_badge_preview_component()
        self.write_loader_component()

        # 6. Pages
        self.write_home_page()
        self.write_packages_page()
        self.write_package_detail_page()
        self.write_docs_page()
        self.write_badges_page()
        self.write_auth_pages()

        print("\n" + "="*50)
        print("✅ PROJET GÉNÉRÉ AVEC SUCCÈS !")
        print("="*50)
        print("Instructions pour le déploiement sur Cloudflare Pages :")
        print(f"1. cd {self.root_dir}")
        print("2. git init")
        print("3. git add .")
        print("4. git commit -m 'Initial commit'")
        print("5. Créez un repo sur GitHub et poussez le code.")
        print("6. Sur Cloudflare Pages, connectez votre GitHub.")
        print("7. Settings build :")
        print("   - Framework: Vite")
        print("   - Command: npm run build")
        print("   - Output directory: dist")
        print("="*50)

