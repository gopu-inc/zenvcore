import axios from 'axios';

const API = axios.create({
  baseURL: "https://zenv-hub.onrender.com",
  headers: { 'Content-Type': 'application/json' },
  timeout: 30000
});

API.interceptors.request.use(c => {
    const t = localStorage.getItem('zenv_token');
    if(t) c.headers.Authorization = `Bearer ${t}`;
    return c;
});

export const ZenvAPI = {
    // Récupération intelligente
    getPackages: async () => {
        try {
            const res = await API.get('/api/packages');
            return res.data.packages || res.data || [];
        } catch { return []; }
    },
    getReadme: (name) => API.get(`/api/readme/${name}`, {responseType: 'text'}),
    auth: {
        login: (d) => API.post('/api/auth/login', JSON.stringify(d)),
        register: (d) => API.post('/api/auth/register', JSON.stringify(d)),
        profile: () => API.get('/api/auth/profile'),
        token: () => API.post('/api/tokens/generate')
    }
};
""")

