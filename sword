# Configuration de la puissance
PROJECT_NAME = "zenv-meta-os-ultimate"
FILE_COUNT_TARGET = 100  # On génère 100 modules système réels (2000 ferait planter le build Cloudflare gratuit)
LINES_PER_FILE_SIMULATION = 1000

def create_dir(path):
    if not os.path.exists(path):
        os.makedirs(path)

def write_file(path, content):
    try:
        with open(path, 'w', encoding='utf-8') as f:
            f.write(content.strip())
        print(f"⚡ [CORE] Généré : {path}")
    except Exception as e:
        print(f"❌ Erreur : {e}")

# Générateur de code "Filler" pour atteindre les 1000 lignes
def generate_massive_code(module_id):
    code = [f"// Zenv Meta OS Kernel Module {module_id}", "export const sys_data = {"]
    for i in range(LINES_PER_FILE_SIMULATION):
        hex_val = '%030x' % random.randrange(16**30)
        code.append(f"  key_{i}: '{hex_val}',")
    code.append("};")
    code.append(f"console.log('Module {module_id} loaded');")
    return "\n".join(code)

