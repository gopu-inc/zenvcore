# Zenv Configuration File - Manifeste du package
# Format: TOML

[Zenv]
name = "zenv[core]"
version = "1.0.0"
author = "Gopu.Inc"
description = "Zenv Package Manager - Core functionality with znv CLI"
license = "MIT"
namespace = "gopu-inc"

[File-build]
main = "zenv/cli.py"
include = [
    "zenv/",
    "README.md",
    "LICENSE",
    "setup.py",
    "package.zcf",
]
exclude = [
    "__pycache__/",
    "*.pyc",
    "*.pyo",
    "ZenvCore.egg-info/",
]

[Dep.py]
# Dépendances Python
requests = ">=2.28.0"
toml = ">=0.10.2"

[entrypoint]
znv = "zenv/cli.py"
zenv = "zenv/cli.py"
zenv-cli = "zenv/cli.py"

[Build]
type = "zenv"
entry_point = "zenv/cli.py"
output = "dist/{name}-{version}.zv"
compression = "gzip"
optimize = true

[Install]
target = "$HOME/.zenv/packages/{name}-{version}"
bin_path = "$HOME/.zenv/bin"
lib_path = "$HOME/.zenv/lib"

[Metadata]
zenv_version = "2.0.0"
requires_python = ">=3.7"
